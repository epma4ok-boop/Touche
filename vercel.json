{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/nudge",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/nudge?scope=love_path",
      "schedule": "0 12 * * *"
    }
  ]
}
